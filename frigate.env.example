# ===========================================================================
# Frigate secrets
# ===========================================================================
#
# INSTALL PATH
#   /opt/frigate/.env
#
# Sitting alongside:
#   /opt/frigate/docker-compose.yml
#   /opt/frigate/config/config.yml
#   /opt/frigate/media/            <- or a separate mount; recordings are large
#
# Rename this file to .env (leading dot) once the values are filled in.
# Keep frigate.env.example in version control; keep .env out of it.
#
#   sudo mkdir -p /opt/frigate/config
#   sudo mv frigate.env.example /opt/frigate/.env
#   sudo chown root:root /opt/frigate/.env
#   sudo chmod 600 /opt/frigate/.env
#
# 600 matters. Docker Compose reads this as root before the container
# starts, so nothing needs group or world read access. A .env that is
# world-readable is barely better than credentials in the config file.
#
# ---------------------------------------------------------------------------
# THIS FILE ONLY WORKS FOR STANDALONE DOCKER
# ---------------------------------------------------------------------------
# If Frigate stays as a Home Assistant add-on, environment variables cannot
# be injected into the container at all. Use an `environment_vars:` block
# inside config.yml instead - see the notes at the bottom of this file.
#
# ---------------------------------------------------------------------------
# TWO ESCAPING TRAPS - read before setting the password
# ---------------------------------------------------------------------------
#
# 1. PERCENT-ENCODE special characters, in the value here.
#    Frigate does a plain string substitution into the RTSP URL; it does not
#    URL-encode for you. So the encoding has to already be in this value.
#
#        actual password:  CHANGE_ME_camera_password
#        value below:      CHANGE_ME_camera_password
#
#    Common ones:  $ -> %24    @ -> %40    # -> %23    / -> %2F
#                  : -> %3A    ? -> %3F    & -> %26    space -> %20
#
# 2. A literal $ ALSO breaks Docker Compose, which treats it as variable
#    interpolation. If you must keep a raw $, double it ($$). Percent-
#    encoding avoids the problem entirely, which is the better reason to do
#    it rather than fight two escaping layers at once.
#
# Do not wrap values in quotes. Compose treats quotes as part of the value.
# Do not put a $ prefix on the reference in config.yml either - Frigate uses
# {FRIGATE_RTSP_PASSWORD}, not ${FRIGATE_RTSP_PASSWORD}.
#
# ===========================================================================


# --- Camera RTSP credentials -----------------------------------------------
# Set these on the cameras first. The previous password was exposed in
# plaintext across all nine camera entries and should be considered burned.
# Ideally use a dedicated non-admin viewer account if the firmware supports
# one, so a leaked credential cannot reconfigure the camera.

FRIGATE_RTSP_USER=viewer
FRIGATE_RTSP_PASSWORD=CHANGE_ME_percent_encoded


# --- MQTT broker -----------------------------------------------------------
# Create a dedicated Mosquitto user for Frigate rather than reusing the
# Home Assistant account. Frigate and Home Assistant must share a broker for
# the integration to work.

FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=CHANGE_ME


# --- GenAI (optional) ------------------------------------------------------
# The llama-server API key, from ~/.llama-api-key on 192.168.50.96.
# Leave blank until the GenAI block in config.yml is actually enabled.

FRIGATE_GENAI_KEY=


# --- Runtime ---------------------------------------------------------------

TZ=America/Chicago

# NOTE: OPENCV_FFMPEG_CAPTURE_OPTIONS is deliberately NOT set here. Its value
# contains a semicolon, which Docker Compose handles fine but which breaks
# the moment anyone runs `set -a; . ./.env` to debug something. It lives in
# the compose `environment:` block below instead, where YAML quoting is
# unambiguous. Keeping this file safe to source is worth the split.


# ===========================================================================
# docker-compose.yml wiring
# ===========================================================================
#
# services:
#   frigate:
#     container_name: frigate
#     image: ghcr.io/blakeblackshear/frigate:stable
#     restart: unless-stopped
#     privileged: false
#     shm_size: "512mb"          # <-- SIZE THIS PROPERLY, see below
#     env_file:
#       - .env
#     environment:
#       # Forces OpenCV to open RTSP over TCP. Frigate uses OpenCV to probe
#       # stream dimensions and it defaults to UDP, which makes startup hang
#       # on cameras that ignore UDP. Lives here rather than in .env because
#       # of the semicolon.
#       - OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
#     devices:
#       - /dev/dri/by-path/pci-0000:XX:00.0-render:/dev/dri/renderD128
#     volumes:
#       - /etc/localtime:/etc/localtime:ro
#       - ./config:/config
#       - ./media:/media/frigate
#       - type: tmpfs
#         target: /tmp/cache
#         tmpfs:
#           size: 1000000000
#     ports:
#       - "8971:8971"            # authenticated UI
#       - "5000:5000"            # internal/unauthenticated - bind to LAN only
#       - "8554:8554"            # go2rtc RTSP
#       - "8555:8555/tcp"        # WebRTC
#       - "8555:8555/udp"
#
# shm_size: the default 64MB is far too small for nine cameras and Frigate
# will die in ways that do not point at shared memory. Frigate's docs give a
# formula based on resolution and camera count - use it rather than guessing.
#
# devices: bind by /dev/dri/by-path/ rather than renderD128 directly. With
# two GPUs in the host the renderD12x numbering is NOT stable across reboots,
# and you will eventually boot into Frigate talking to the wrong card. Find
# the right path with:  ls -l /dev/dri/by-path/
#
#
# ===========================================================================
# IF YOU STAY ON THE HOME ASSISTANT ADD-ON
# ===========================================================================
#
# None of the above applies - add-ons cannot receive environment variables.
# Frigate provides an in-config alternative. Add this block at the TOP of
# config.yml, then use the same {FRIGATE_*} references everywhere else:
#
#     environment_vars:
#       FRIGATE_RTSP_USER: viewer
#       FRIGATE_RTSP_PASSWORD: CHANGE_ME_percent_encoded
#       FRIGATE_MQTT_USER: frigate
#       FRIGATE_MQTT_PASSWORD: CHANGE_ME
#
# Be clear-eyed about what this does and does not buy you. The secrets are
# still sitting in plaintext in config.yml - this is a maintainability win
# (one place to rotate instead of eighteen URLs), not a security one. If
# keeping credentials out of the config file actually matters to you, that
# is a genuine argument for the standalone Docker VM.
#
# Add-on config location, where <slug> varies by which variant you installed
# (e.g. ccab4aaf_frigate, or ccab4aaf_frigate-fa for Full Access):
#
#     /addon_configs/<slug>/config.yml
#
# Note it is config.yml, not frigate.yml - a common source of "Frigate is
# ignoring my config and using the demo camera at 10.0.10.10" confusion.
#
#
# ===========================================================================
# A NOTE ON DOCKER SECRETS
# ===========================================================================
# Docker Swarm secrets mounted at /run/secrets/FRIGATE_* have been reported
# not to substitute correctly in Frigate. Use env_file. If you want secrets
# off the filesystem entirely, that is a job for a proper secrets manager
# feeding the environment at container start, not for Frigate's own
# substitution mechanism.
